PLAYSTORE_RADAR_LOGIN_PASSWORD=000000
PLAYSTORE_RADAR_SECRET_KEY=
PLAYSTORE_RADAR_COOKIE_SECURE=

# Diretório dos relatórios; localmente não precisa alterar
